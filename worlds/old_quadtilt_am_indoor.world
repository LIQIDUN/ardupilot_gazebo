              <normal_map>__default__</normal_map>
            </shader>
            <ambient>1 0.3 0.3 1</ambient>
            <diffuse>1 0.7 0.7 1</diffuse>
            <specular>1 0.01 0.01 1</specular>
            <emissive>1 0 0 1</emissive>
          </material>
          <transparency>0</transparency>
          <cast_shadows>1</cast_shadows>
        </visual>
        <collision name='collision'>
          <laser_retro>0</laser_retro>
          <max_contacts>10</max_contacts>
          <pose>0 0 0 0 -0 0</pose>
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
                <fdir1>0 0 0</fdir1>
                <slip1>0</slip1>
                <slip2>0</slip2>
              </ode>
              <torsional>
                <coefficient>1</coefficient>
                <patch_radius>0</patch_radius>
                <surface_radius>0</surface_radius>
                <use_patch_radius>1</use_patch_radius>
                <ode>
                  <slip>0</slip>
                </ode>
              </torsional>
            </friction>
            <bounce>
              <restitution_coefficient>0</restitution_coefficient>
              <threshold>1e+06</threshold>
            </bounce>
            <contact>
              <collide_without_contact>0</collide_without_contact>
              <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
              <collide_bitmask>1</collide_bitmask>
              <ode>
                <soft_cfm>0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e+13</kp>
                <kd>1</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0</min_depth>
              </ode>
              <bullet>
                <split_impulse>1</split_impulse>
                <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
                <soft_cfm>0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e+13</kp>
                <kd>1</kd>
              </bullet>
            </contact>
          </surface>
        </collision>
      </link>
      <static>1</static>
      <allow_auto_disable>1</allow_auto_disable>
      <pose>10 0 0 0 -0 0</pose>
    </model>
    <model name="quadtilt_am">
      <pose> 0 0 0.25 0 0 0 </pose>
      <include>
        <uri>model://quadtilt_am</uri>
         <pose> 0 0 0 0 0 0 </pose>
      </include>
    </model>

    <model name='target'>
      <pose>16.0 0.0 1.05 0 0 0</pose> 
      <link name='link_0'>
        <inertial>
          <!-- 1. 修正惯性张量：10g, 2cm方块的惯性矩应该是 6.6e-7 -->
          <mass>0.01</mass>
          <inertia>
            <ixx>6.6e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>6.6e-07</iyy>
            <iyz>0</iyz>
            <izz>6.6e-07</izz>
          </inertia>
        </inertial>
        
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.02 0.02 0.02</size>
            </box>
          </geometry>
          <surface>
            <contact>
              <ode>
                <!-- 2. 降低 kp：1e13 太硬了，改用 1e5 或 1e6 -->
                <kp>1e+06</kp>
                <!-- 3. 增加 kd：增加阻尼，吸收震动能量 -->
                <kd>100</kd>
                <!-- 4. 允许微小穿透，增加稳定性 -->
                <soft_cfm>0.001</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction>
              <ode>
                <!-- 5. 增加摩擦力，防止在地面滑动 -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name='visual'>
          <geometry>
            <box>
              <size>0.02 0.02 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
      
      <!-- 6. 开启自动休眠：如果不动时让它进入睡眠状态 -->
      <allow_auto_disable>1</allow_auto_disable>
      <static>0</static>
    </model>
   
    
  </world>
</sdf>