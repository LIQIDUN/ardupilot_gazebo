    <plugin name="rotor_3_blade_1" filename="libLiftDragPlugin.so"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall><area>0.002</area><air_density>1.2041</air_density><cp>0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>properller_3_Link</link_name></plugin>
    <plugin name="rotor_3_blade_2" filename="libLiftDragPlugin.so"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall><area>0.002</area><air_density>1.2041</air_density><cp>-0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>properller_3_Link</link_name></plugin>

    <!-- 固定翼气动插件 (引入自 standard_vtol) -->
    <plugin name="left_wing" filename="libLiftDragPlugin.so">
      <a0>0.1087340124</a0><cla>4.752798721</cla><cda>0.6417112299</cda><cma>-1.8</cma>
      <alpha_stall>0.3391428111</alpha_stall><cla_stall>-3.85</cla_stall><cda_stall>-0.9233984055</cda_stall><cma_stall>0</cma_stall>
      <cp>-0.05 0.3 0.05</cp><area>0.12</area><air_density>1.2041</air_density><forward>1 0 0</forward><upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>left_elevon_joint</control_joint_name>
      <control_joint_rad_to_cl>-0.5</control_joint_rad_to_cl>
    </plugin>
    <plugin name="right_wing" filename="libLiftDragPlugin.so">
      <a0>0.1087340124</a0><cla>4.752798721</cla><cda>0.6417112299</cda><cma>-1.8</cma>
      <alpha_stall>0.3391428111</alpha_stall><cla_stall>-3.85</cla_stall><cda_stall>-0.9233984055</cda_stall><cma_stall>0</cma_stall>
      <cp>-0.05 -0.3 0.05</cp><area>0.12</area><air_density>1.2041</air_density><forward>1 0 0</forward><upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>right_elevon_joint</control_joint_name>
      <control_joint_rad_to_cl>-0.5</control_joint_rad_to_cl>
    </plugin>
    <plugin name="elevator" filename="libLiftDragPlugin.so">
      <a0>-0.2</a0><cla>4.752798721</cla><cda>0.6417112299</cda><cma>-1.8</cma>
      <alpha_stall>0.3391428111</alpha_stall><cla_stall>-3.85</cla_stall><cda_stall>-0.9233984055</cda_stall><cma_stall>0</cma_stall>
      <cp>-0.5 0 0</cp><area>0.01</area><air_density>1.2041</air_density><forward>1 0 0</forward><upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>elevator_joint</control_joint_name>
      <control_joint_rad_to_cl>-4.0</control_joint_rad_to_cl>
    </plugin>
    <plugin name="rudder" filename="libLiftDragPlugin.so">
      <a0>0.0</a0><cla>4.752798721</cla><cda>0.6417112299</cda><cma>-1.8</cma>
      <alpha_stall>0.3391428111</alpha_stall><cla_stall>-3.85</cla_stall><cda_stall>-0.9233984055</cda_stall><cma_stall>0</cma_stall>
      <cp>-0.5 0 0.05</cp><area>0.02</area><air_density>1.2041</air_density><forward>1 0 0</forward><upward>0 1 0</upward>
      <link_name>base_link</link_name>
    </plugin>

    <!-- ArduPilot Control -->
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>quadtilt::imu_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>

      <!-- Motors (0-3) -->
      <control channel="0"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_0</jointName><multiplier>800</multiplier></control>
      <control channel="1"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_1</jointName><multiplier>800</multiplier></control>
      <control channel="2"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_2</jointName><multiplier>-800</multiplier></control>
      <control channel="3"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_3</jointName><multiplier>-800</multiplier></control>

      <!-- Tilt Servos (4-7) - NO OFFSET as requested -->
      <control channel="4"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_0</jointName><multiplier>-1.495</multiplier></control>
      <control channel="5"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_1</jointName><multiplier>-1.495</multiplier></control>
      <control channel="6"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_2</jointName><multiplier>-1.495</multiplier></control>
      <control channel="7"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_3</jointName><multiplier>-1.495</multiplier></control>

      <!-- Control Surfaces (8-10) 引入自 standard_vtol，分配至 SERVO9, 10, 11 -->
      <control channel="8">
        <multiplier>1</multiplier><offset>-0.5</offset><type>POSITION</type>
        <p_gain>2.5</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1</cmd_max><cmd_min>-1</cmd_min>
        <jointName>left_elevon_joint</jointName>
      </control>
      <control channel="9">
        <multiplier>1</multiplier><offset>-0.5</offset><type>POSITION</type>
        <p_gain>2.5</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1</cmd_max><cmd_min>-1</cmd_min>
        <jointName>right_elevon_joint</jointName>
      </control>
      <control channel="10">
        <multiplier>1</multiplier><offset>-0.5</offset><type>POSITION</type>
        <p_gain>2.5</p_gain><i_gain>0</i_gain><d_gain>0.1</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1</cmd_max><cmd_min>-1</cmd_min>
        <jointName>elevator_joint</jointName>
      </control>
    </plugin>
  </model>
</sdf>