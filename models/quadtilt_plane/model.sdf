    <joint name='tilt_0' type='revolute'>
      <pose relative_to='base_link'>0.21395 -0.26061 -0.04345 -1.57079 -1.57079 -3.14159</pose>
      <parent>base_link</parent>
      <child>tilt_0_Link</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>10</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='tilt_0_Link'>
