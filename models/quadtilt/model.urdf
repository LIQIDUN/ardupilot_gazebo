<?xml version="1.0" encoding="utf-8"?>
<robot name="quadtilt">
  <!-- ========================================== -->
  <!-- BASE LINK (含碰撞盒)                       -->
  <!-- ========================================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.12253 -0.0013173 -0.0057999" rpy="0 0 0" />
      <mass value="13.83" />
      <inertia ixx="0.086619" ixy="2.2852E-05" ixz="-0.00027792" iyy="0.13538" iyz="-9.9786E-06" izz="0.20791" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/base_link.STL" /></geometry>
      <material name=""><color rgba="1 1 1 1" /></material>
    </visual>
    <!-- 碰撞盒：Box 替代 Mesh -->
    <collision>
      <origin xyz="-0.1 0 -0.15" rpy="0 0 0" />
      <geometry><box size="0.8 0.8 0.2" /></geometry>
    </collision>
  </link>
  <!-- ================= TILT 0 (前右) ================= -->
  <link name="tilt_0_Link">
    <inertial>
      <origin xyz="0.02 0 -0.02" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_0_Link.STL" /></geometry>
      <material name=""><color rgba="1 0 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_0_Link.STL" /></geometry>
    </collision>
  </link>
  <joint name="tilt_0" type="revolute">
    <origin xyz="0.21395 -0.26061 -0.04345" rpy="1.5708 -1.5708 0" />
    <parent link="base_link" />
    <child link="tilt_0_Link" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0" />
  </joint>
  <link name="properller_0_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_0_Link.STL" /></geometry>
      <material name=""><color rgba="0 0 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_0_Link.STL" /></geometry>
    </collision>
  </link>
  <joint name="properller_0" type="continuous">
    <origin xyz="0.07705 0 -0.0255" rpy="-1.5708 0 -1.5708" />
    <parent link="tilt_0_Link" />
    <child link="properller_0_Link" />
    <axis xyz="0 0 1" />
  </joint>
  <!-- ================= TILT 1 (后左) ================= -->
  <link name="tilt_1_Link">
    <inertial>
      <origin xyz="0.02 0 -0.02" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_1_Link.STL" /></geometry>
      <material name=""><color rgba="1 0 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_1_Link.STL" /></geometry>
    </collision>
  </link>
  <joint name="tilt_1" type="revolute">
    <origin xyz="-0.21395 0.2094 -0.04345" rpy="1.5708 1.5708  0" />
    <parent link="base_link" />
    <child link="tilt_1_Link" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0" />
  </joint>
  <link name="properller_1_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_1_Link.STL" /></geometry>
      <material name=""><color rgba="0 0 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_1_Link.STL" /></geometry>
    </collision>
  </link>
  <joint name="properller_1" type="continuous">
    <origin xyz="0.07705 0 -0.02573" rpy="1.5708 0 -1.5708" />
    <parent link="tilt_1_Link" />
    <child link="properller_1_Link" />
    <axis xyz="0 0 1" />
  </joint>
  <!-- ================= TILT 2 (前左 - 视觉修正) ================= -->
  <link name="tilt_2_Link">
    <inertial>
      <origin xyz="0.02 0 -0.02" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
    <visual>
      <!-- 如果之前有偏移，请在这里的 xyz 填入你刚才调试好的数值 -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_2_Link.STL" /></geometry>
      <material name=""><color rgba="0 1 0 1" /></material>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_2_Link.STL" /></geometry>
    </collision> -->
  </link>
  <joint name="tilt_2" type="revolute">
    <origin xyz="0.21395 0.2094 -0.04345" rpy="1.5708 -1.5708 0" />
    <parent link="base_link" />
    <child link="tilt_2_Link" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0" />
  </joint>
  <link name="properller_2_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
    </inertial>
    <visual>
      <!-- 修正螺旋桨视觉方向 -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_2_Link.STL" /></geometry>
      <material name=""><color rgba="0 0 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_2_Link.STL" /></geometry>
    </collision>
  </link>
  <joint name="properller_2" type="continuous">
    <origin xyz="0.077 0 -0.025" rpy="-1.5708 0 -1.5708" />
    <parent link="tilt_2_Link" />
    <child link="properller_2_Link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ================= TILT 3 (后右 - 视觉修正) ================= -->
  <link name="tilt_3_Link">
    <inertial>
      <origin xyz="0.02 0 -0.02" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
    <visual>
      <!-- 如果之前有偏移，请在这里的 xyz 填入你刚才调试好的数值 -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_3_Link.STL" /></geometry>
      <material name=""><color rgba="0 1 0 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/tilt_3_Link.STL" /></geometry>
    </collision>
  </link>
  <joint name="tilt_3" type="revolute">
    <origin xyz="-0.21395 -0.26061 -0.04345" rpy="1.5708 1.5708 0" />
    <parent link="base_link" />
    <child link="tilt_3_Link" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0" />
  </joint>
  <link name="properller_3_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
    </inertial>
    <visual>
      <!-- 修正螺旋桨视觉方向 -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_3_Link.STL" /></geometry>
      <material name=""><color rgba="0 0 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://quadtilt/meshes/properller_3_Link.STL" /></geometry>
    </collision>
  </link>
  <!-- 修正：Prop 3 轴向修正为 -1 -->
  <joint name="properller_3" type="continuous">
    <origin xyz="0.077 0 -0.025" rpy="1.5708 0 -1.5708" />
    <parent link="tilt_3_Link" />
    <child link="properller_3_Link" />
    <axis xyz="0 0 1" /> 
  </joint>
  <!-- ========================================== -->
  <!-- GAZEBO 专属配置 (解决滑动问题)              -->
  <!-- ========================================== -->
  <gazebo reference="base_link">
    <!-- mu1/mu2: 摩擦系数 (100非常大，相当于橡胶轮胎) -->
    <mu1>100.0</mu1>
    <mu2>50.0</mu2>
    <!-- kp/kd: 接触刚度和阻尼，防止接触抖动 -->
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <!-- maxVel: 限制接触修正速度，防止反弹 -->
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>
</robot>