          <inertia>
            <ixx>6.6e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>6.6e-07</iyy>
            <iyz>0</iyz>
            <izz>6.6e-07</izz>
          </inertia>
        </inertial>
        
