    <!-- Aero Prop 3 (CW) -->
    <plugin name="rotor_3_blade_1" filename="libLiftDragPlugin.so"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall><area>0.0045</area><air_density>1.2041</air_density><cp>0.13 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>properller_3_Link</link_name></plugin>
    <plugin name="rotor_3_blade_2" filename="libLiftDragPlugin.so"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall><area>0.0045</area><air_density>1.2041</air_density><cp>-0.13 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>properller_3_Link</link_name></plugin>

    <!-- ArduPilot Control -->
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>quadtilt_new::imu_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>

      <!-- Motors (0-3) -->
      <control channel="0"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_0_joint</jointName><multiplier>800</multiplier></control>
      <control channel="1"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_1_joint</jointName><multiplier>800</multiplier></control>
      <control channel="2"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_2_joint</jointName><multiplier>-800</multiplier></control>
      <control channel="3"><type>VELOCITY</type><offset>0</offset><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><jointName>properller_3_joint</jointName><multiplier>-800</multiplier></control>

      <!-- Tilt Servos (4-7)  -->
      <!-- deg_out_red = multiplier*(input(pwm to 0-1)+offset) -->
      <control channel="4"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_0_joint</jointName><multiplier>1.495</multiplier></control>
      <control channel="5"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_1_joint</jointName><multiplier>1.495</multiplier></control>
      <!-- <control channel="6"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_2</jointName><multiplier>-1.495</multiplier></control>
      <control channel="7"><type>POSITION</type><offset>-0.85</offset><p_gain>40.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min><jointName>tilt_3</jointName><multiplier>-1.495</multiplier></control> -->
      <control channel="6">
        <type>POSITION</type>
        <offset>-0.5</offset>
        <p_gain>20.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
        <jointName>robotic_arm::joint_1</jointName>
        <multiplier>4.7124</multiplier>
      </control>
      <control channel="7">
        <type>POSITION</type>
        <offset>-0.5</offset>
        <p_gain>20.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.05</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
        <jointName>robotic_arm::joint_2</jointName>
        <multiplier>4.7124</multiplier>
      </control>
      <control channel="8">
        <type>POSITION</type>
        <offset>-0.5</offset>
        <p_gain>20.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.05</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
        <jointName>robotic_arm::joint_3</jointName>
        <multiplier>4.7124</multiplier>
      </control>
      <control channel="9">
        <type>POSITION</type>
        <offset>-0.5</offset>
        <p_gain>20.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.05</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
        <jointName>robotic_arm::joint_4</jointName>
        <multiplier>4.7124</multiplier>
      </control>
      <control channel="10">
        <type>POSITION</type>
        <offset>-0.5</offset>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
        <jointName>robotic_arm::joint_5</jointName>
        <multiplier>4.7124</multiplier>
      </control>
     
<!-- Gripper Left Finger (Channel 11) -->
      <control channel="11">
        <type>POSITION</type>
        <offset>0</offset>
        <!-- 【关键修改】 P值降到极低，只要能缓慢合上就行 -->
        <p_gain>0.5</p_gain>
        <i_gain>0</i_gain>
        <!-- 【关键修改】 D值降到微小，防止导数项放大高频噪声 -->
        <d_gain>0.01</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <!-- 【关键修改】 限制最大输出力矩为 1N，5g的物体1N足够推得飞快了 -->
        <cmd_max>1.0</cmd_max>
        <cmd_min>-1.0</cmd_min>
        <jointName>robotic_arm::left_finger_joint</jointName>
        <multiplier>0.025</multiplier>
      </control>

      <!-- Gripper Right Finger (Channel 11) -->
      <control channel="11">
        <type>POSITION</type>
        <offset>0</offset>
        <p_gain>0.5</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.01</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>1.0</cmd_max>
        <cmd_min>-1.0</cmd_min>
        <jointName>robotic_arm::right_finger_joint</jointName>
        <multiplier>0.025</multiplier>
      </control>

    </plugin>

    <include>
      <uri>model://robotic_arm</uri>
      <name>robotic_arm</name>
      <pose>0 0 -0.04 3.1416 0 0</pose> <!-- 挂在飞机重心下方 -->
    </include>

    <joint name="arm_weld" type="fixed">
      <parent>base_link</parent> <!-- 飞机的底座名字 -->
      <child>robotic_arm::base_link</child>
    </joint>

  </model>
</sdf>
