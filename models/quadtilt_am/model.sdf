<sdf version='1.7'>
  <model name='quadtilt_new'>
    <link name='base_link'>
      <inertial>
        <pose>0.0 -0.000647 0.024368 0 -0 0</pose>
        <mass>2.3411</mass>
        <inertia>
          <ixx>0.0013622</ixx>
          <ixy>1.2109e-05</ixy>
          <ixz>2.1278e-05</ixz>
          <iyy>0.011253</iyy>
          <iyz>1.003e-06</iyz>
          <izz>0.011215</izz>
        </inertia>
      </inertial>
      <!-- <collision name='base_link_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://quadtilt_new/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <max_contacts>30</max_contacts> 
        <surface>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision> -->

      <collision name='landing_gear_front_collision'>
      <pose>-0.3 0 -0.18 0 0 0</pose> <!-- ⚠️ 请替换为你前起落架脚尖的实际坐标 -->
      <geometry>
        <!-- <box><size>0.03 0.03 0.01</size></box> -->
        <sphere><radius>0.03</radius></sphere>
      </geometry>
      <surface>
        <!-- <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.0</max_vel><min_depth>0.002</min_depth></ode></contact> -->
        <contact>
          <ode>
            <!-- [关键1] 降低刚度 kp。原本1e6太硬像钢铁，现在1e5(十万)像硬橡胶 -->
            <kp>1000000</kp>
            <!-- [关键2] 极大提高阻尼 kd。以前是100，现在2000。吸收一切高频震动动能 -->
            <kd>10</kd>
            <!-- [关键3] 给一个极小但非0的允许修正速度，防止挤压应力把 EKF 炸掉 -->
            <max_vel>0.2</max_vel>
            <!-- [关键4] 允许 5 毫米的弹性形变陷落深度，作为物理缓冲层 -->
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </surface>
    </collision>

    <!-- 左起落架脚垫 -->
    <collision name='landing_gear_left_collision'>
      <pose>0.3 0.2 -0.18 0 0 0</pose> <!-- ⚠️ 请替换为实际坐标 -->
      <geometry>
        <!-- <box><size>0.03 0.03 0.01</size></box> -->
        <sphere><radius>0.03</radius></sphere>
      </geometry>
      <surface>
        <!-- <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.0</max_vel><min_depth>0.002</min_depth></ode></contact> -->
        <contact>
          <ode>
            <!-- [关键1] 降低刚度 kp。原本1e6太硬像钢铁，现在1e5(十万)像硬橡胶 -->
            <kp>1000000</kp>
            <!-- [关键2] 极大提高阻尼 kd。以前是100，现在2000。吸收一切高频震动动能 -->
            <kd>10</kd>
            <!-- [关键3] 给一个极小但非0的允许修正速度，防止挤压应力把 EKF 炸掉 -->
            <max_vel>0.2</max_vel>
            <!-- [关键4] 允许 5 毫米的弹性形变陷落深度，作为物理缓冲层 -->
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </surface>
    </collision>

    <!-- 右起落架脚垫 -->
    <collision name='landing_gear_right_collision'>
      <pose>0.3 -0.2 -0.18 0 0 0</pose> <!-- ⚠️ 请替换为实际坐标 -->
      <geometry>
        <!-- <box><size>0.03 0.03 0.01</size></box> -->
        <sphere><radius>0.03</radius></sphere>
      </geometry>
      <surface>
        <!-- <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.0</max_vel><min_depth>0.002</min_depth></ode></contact> -->
        <contact>
          <ode>
            <!-- [关键1] 降低刚度 kp。原本1e6太硬像钢铁，现在1e5(十万)像硬橡胶 -->
            <kp>1000000</kp>
            <!-- [关键2] 极大提高阻尼 kd。以前是100，现在2000。吸收一切高频震动动能 -->
            <kd>10</kd>
            <!-- [关键3] 给一个极小但非0的允许修正速度，防止挤压应力把 EKF 炸掉 -->
            <max_vel>0.2</max_vel>
            <!-- [关键4] 允许 5 毫米的弹性形变陷落深度，作为物理缓冲层 -->
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </surface>
    </collision>


      <visual name='base_link_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://quadtilt_new/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
    </link>

    <!-- IMU Link -->
    <link name='imu_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00002</iyy><iyz>0</iyz><izz>0.00002</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 3.141593 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name='imu_joint' type='fixed'>
      <child>imu_link</child>
      <parent>base_link</parent>
      <!-- <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>0</upper><effort>0</effort><velocity>0</velocity></limit>
      </axis> -->
    </joint>


    <joint name='tilt_0_joint' type='revolute'>
      <pose relative_to='base_link'>0.255 0 0 -1.5708 -1.5708 -3.14159</pose>
      <parent>base_link</parent>
      <child>tilt_0_Link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>10</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='tilt_0_Link'>
