<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='obs_box_10_0.2_2.5'>
      <link name='link_0'>
        <inertial>
          <mass>100</mass>
          <!-- 惯性张量建议也随尺寸调整，但对于 static 模型其实不重要 -->
          <inertia>
            <ixx>166.667</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>166.667</iyy><iyz>0</iyz><izz>166.667</izz>
          </inertia>
        </inertial>

        
        <collision name='collision'>
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>10.0 0.2 2.5</size>
            </box>
          </geometry>
          <surface>
            <contact>
              <ode>
               
                <kp>1e+06</kp>
                
                <kd>100</kd>
                
                <soft_cfm>0.001</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction>
              <ode>
                
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name='visual'>
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>10.0 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.996 0.474 0.019 1</ambient> <!-- 保持你之前的橙色 -->
          <diffuse>0.996 0.474 0.019 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
      
      <!-- 6. 开启自动休眠：如果不动时让它进入睡眠状态 -->
      <allow_auto_disable>1</allow_auto_disable>
      <static>0</static>
  </model>
</sdf>
