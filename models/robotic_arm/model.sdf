<sdf version='1.7'>
  <model name='robotic_arm'>
    <link name='base_link'>
      <inertial>
        <pose>-0.000805 -3.1e-05 0.015733 0 -0 0</pose>
        <mass>0.34432</mass>
        <inertia>
          <ixx>0.00026968</ixx>
          <ixy>-2.6656e-10</ixy>
          <ixz>-8.0892e-08</ixz>
          <iyy>0.00027222</iyy>
